<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GameFoldPc.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/gamefold_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/gamefold_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Pluvia</item>
    </style>

    <style name="Theme.Pluvia" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
